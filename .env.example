# Llave de la API de Anthropic (Claude)
# Requerida para generar el Plan de Evacuación Asistido por IA.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Credenciales de Supabase (Acceso Público Anónimo)
# Requerido para leer alertas de Defensa Civil y caudales del COES en tiempo real.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here

# Llave de servicio de Supabase (solo servidor — NUNCA exponerla al cliente)
# Requerida para el scraper del COES que escribe en hydrology_readings.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here

# Agente de Usuario para Nominatim OpenStreetMap Geocoding
# Usar formato: NombreApp/Version (contacto: tu-correo@gmail.com) para evitar bloqueos.
NOMINATIM_USER_AGENT=YakuAlert/1.0 (contacto: ricardosv46@gmail.com)
